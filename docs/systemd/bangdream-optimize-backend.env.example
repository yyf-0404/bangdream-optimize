# 需要公网访问时改为 0.0.0.0；仅本机访问可用 127.0.0.1
BANGDREAM_OPTIMIZE_HOST=127.0.0.1
BANGDREAM_OPTIMIZE_PORT=3100
BANGDREAM_OPTIMIZE_MONGODB_URI='mongodb://USER:PASSWORD@127.0.0.1:27017/'
BANGDREAM_OPTIMIZE_MONGODB_DB=tsugu-bangdream-bot
BANGDREAM_OPTIMIZE_GAME_DATA_ROOT=/var/bangdream-optimize/game-data

# Optional feedback email submission through Stalwart SMTPS (implicit TLS).
# Use an app password created for feedback@your-domain.example, never an admin API key.
# BANGDREAM_OPTIMIZE_FEEDBACK_SMTP_HOST=mail.your-domain.example
# BANGDREAM_OPTIMIZE_FEEDBACK_SMTP_PORT=465
# BANGDREAM_OPTIMIZE_FEEDBACK_SMTP_USERNAME=feedback@your-domain.example
# BANGDREAM_OPTIMIZE_FEEDBACK_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
# BANGDREAM_OPTIMIZE_FEEDBACK_FROM=feedback@your-domain.example
# BANGDREAM_OPTIMIZE_FEEDBACK_TO=feedback@your-domain.example
# BANGDREAM_OPTIMIZE_FEEDBACK_RATE_LIMIT=3
# BANGDREAM_OPTIMIZE_FEEDBACK_RATE_WINDOW_SECONDS=600
# Enable only when the reverse proxy overwrites X-Real-IP/X-Forwarded-For.
# BANGDREAM_OPTIMIZE_FEEDBACK_TRUST_PROXY_HEADERS=true

# Optional telemetry and periodic sync
BANGDREAM_OPTIMIZE_TELEMETRY_JSONL=/var/bangdream-optimize/telemetry.jsonl
BANGDREAM_OPTIMIZE_GAME_DATA_SYNC_ENABLED=1
BANGDREAM_OPTIMIZE_GAME_DATA_SYNC_INTERVAL_SECONDS=3600
# 可选：显式指定同步工具；若不设置，服务会优先查找与 server 二进制同目录的同名工具。
# BANGDREAM_OPTIMIZE_GAME_DATA_SYNC_COMMAND=/opt/bangdream-optimize/target/release/bangdream-optimize-sync-bestdori

# CN game account import is enabled by default. Keep the real persist.json
# backend-private and expose only /bangdream/user-data/import through the
# reverse proxy. The default path is var/bangdream-account/persist.json under
# the service WorkingDirectory; copy var/bangdream-account/persist.example.json
# there and fill real values. Uncomment either line below to override or disable.
# BANGDREAM_OPTIMIZE_ENABLE_BD_IMPORT=false
# BANGDREAM_OPTIMIZE_BD_PERSIST=/opt/bangdream-optimize/var/bangdream-account/persist.json
# BANGDREAM_OPTIMIZE_BD_PERSIST_DIR=/secure/bd-persist
